# FactoryLoop Environment Configuration Example
# Copy this file to .env and customize before production deployment

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=order_to_audit
DB_PORT=5432

# Backend API Configuration
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=80
NODE_ENV=development

# Security - Set a strong cryptographically random secret in production
JWT_SECRET=order-to-audit-secret-key-2024
JWT_EXPIRES_IN=24h

# Full Database URL (Overridden in cloud environments like Neon / Supabase / Vercel)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_to_audit

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
